{
  "name": "boringstack",
  "private": true,
  "description": "BoringStack monorepo — api, ui, docs, and infra templates",
  "scripts": {
    "regen": "bash scripts/stack-regen.sh",
    "check": "bash scripts/stack-check.sh",
    "check:full": "bash scripts/stack-check.sh --full",
    "rename:project": "bash scripts/rename-project.sh",
    "spec:init": "bun scripts/spec-init.ts",
    "postinstall": "bash scripts/ci/install-git-hooks.sh",
    "install:hooks": "bash scripts/ci/install-git-hooks.sh"
  },
  "packageManager": "bun@1.3.14"
}
