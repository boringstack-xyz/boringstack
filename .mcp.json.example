{
  "mcpServers": {
    "postgres": {
      "command": "uvx",
      "args": ["--python", "3.13", "postgres-mcp", "--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "postgresql://app:app_dev_password@localhost:5432/app"
      }
    },
    "valkey": {
      "command": "uvx",
      "args": [
        "--from",
        "redis-mcp-server@latest",
        "redis-mcp-server",
        "--url",
        "redis://localhost:6379/0"
      ]
    }
  }
}
