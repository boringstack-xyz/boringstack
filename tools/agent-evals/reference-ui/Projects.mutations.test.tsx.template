import type { ReactNode } from "react";

import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
import { act, renderHook } from "@testing-library/react";
import { beforeEach, expect, it, vi } from "vitest";

import { useSaveProject } from "./Projects.mutations";

const api = vi.hoisted(() => ({ POST: vi.fn(), PATCH: vi.fn() }));

vi.mock("@/lib/api/client", () => ({ apiClient: api }));
beforeEach(() => {
  vi.resetAllMocks();
});

function wrapper({ children }: { readonly children: ReactNode }) {
  return (
    <QueryClientProvider client={new QueryClient()}>
      {children}
    </QueryClientProvider>
  );
}

it("rename sends only the allowed name field to the selected record", async () => {
  api.PATCH.mockResolvedValue({ data: {} });
  const { result } = renderHook(() => useSaveProject("a"), { wrapper });

  await act(() => result.current.mutateAsync({ id: "p", name: "Renamed" }));
  expect(api.PATCH).toHaveBeenCalledWith("/api/v1/projects/{id}", {
    params: { path: { id: "p" } },
    body: { name: "Renamed" }
  });
  expect(api.POST).not.toHaveBeenCalled();
});
it("without an active account a mutation cannot reach the API", async () => {
  const { result } = renderHook(() => useSaveProject(undefined), { wrapper });

  await act(async () => {
    await expect(
      result.current.mutateAsync({ name: "Denied" })
    ).rejects.toThrow("No active account");
  });
  expect(api.POST).not.toHaveBeenCalled();
  expect(api.PATCH).not.toHaveBeenCalled();
});
