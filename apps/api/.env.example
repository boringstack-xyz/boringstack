# Required to boot the API.
NODE_ENV=development
PORT=7330
LOG_LEVEL=info
DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/app
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Optional PEM CA bundle for production Postgres TLS verification.
DATABASE_SSL_CA=
# Postgres connection pool size, per API instance. Default 10.
# DATABASE_POOL_SIZE=10
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# AES-256-GCM key for MFA TOTP secret storage. REQUIRED in production —
# boot aborts if empty when NODE_ENV=production. Generate with:
#   openssl rand -base64 32
# Rotating this key invalidates every existing MFA enrollment, so treat
# it like a database master key: pick once, store in your secret manager,
# never edit in place.
MFA_ENCRYPTION_KEY=

# Public-facing identity + CORS.
APP_NAME=API Template
# BoringStack runs same-origin by default: Traefik path-routes /api/* on the
# same host that serves the SPA, so the CORS middleware is NOT mounted unless
# you explicitly set ALLOWED_ORIGINS. Set it only for cross-origin deployments
# (api on a different host than the SPA).
FRONTEND_URL=http://localhost:7331
ALLOWED_ORIGINS=

# Public URL the API itself is reachable at. Used to build OAuth redirect
# URIs — must match the URI registered with each OAuth provider's console.
# Same-origin: <frontend-url>. Cross-origin: the api's own domain.
PUBLIC_API_URL=http://localhost:7331

# Per-IP rate limit (defense-in-depth alongside any reverse-proxy limit).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Stricter per-IP limit on credentialing routes (register, login, forgot-password).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Set to true when running behind a reverse proxy (Traefik, nginx,
# Cloudflare). The rate limiter then reads X-Forwarded-For instead of
# the socket peer IP — otherwise every client shares one bucket and a
# single bad actor locks the whole deploy out. The compose stack runs
# Traefik in front, so production should always be true. Direct
# internet-exposed deploys leave it false (XFF is spoofable without a
# proxy in front).
TRUST_PROXY=false

# Optional first-boot superuser. When both are set, `bun run db:seed`
# creates a user with admin role on the first run. Empty = no user
# created; sign up via the registration flow instead.
#
# Running under docker-compose? Setting these HERE has no effect — the
# api-migrate service interpolates `${SUPERUSER_EMAIL}` from
# `infra/compose/compose/.env`, not from this file.
# Put them in compose/.env instead. (`bun run dev` standalone still
# reads them from this file as expected.)
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# Local/browser E2E support. Enables test-only auth helpers such as
# /api/v1/auth/__test/force-verify outside NODE_ENV=test. Keep false in prod.
# Docker Compose dev (`api-dev`) defaults this to true via
# API_DEV_E2E_TEST_ENDPOINTS_ENABLED so Playwright can force-verify users.
E2E_TEST_ENDPOINTS_ENABLED=false

# --- Error tracking — Sentry-compatible ---------------------------------
# DSN can point at self-hosted GlitchTip (see
# infra/compose/docs/glitchtip.md) or sentry.io — same
# wire protocol. Empty DSN means Sentry is not initialized.
SENTRY_DSN=
# Default 0: OpenTelemetry → Tempo is the trace backend; Sentry / GlitchTip
# stays error-capture-only. Set non-zero only if you want transactions in
# Sentry as well — running both tracers concurrently double-instruments
# the request path (Sentry's Bun SDK is built on @sentry/opentelemetry).
SENTRY_TRACES_SAMPLE_RATE=0

# --- Tracing — OpenTelemetry → Tempo ------------------------------------
# When OTEL_EXPORTER_OTLP_ENDPOINT is set, the API ships spans via OTLP/HTTP
# to that endpoint (Tempo, bundled in the compose stack). Empty = the OTel
# SDK is not initialized. In compose this is wired automatically; set it here
# only for bare-bun local tracing. OTEL_SERVICE_NAME is the `service.name`
# Grafana groups spans by in Tempo's Explore tab.
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=boringstack-api

# Email — pick one provider; only that provider's keys are required.
# Default: Cloudflare Email Service (https://developers.cloudflare.com/email-service/).
# Setup walkthrough: infra/compose/docs/runbooks/cloudflare-email.md
# In dev with all keys empty, a noop provider is used and emails are logged.
# For local template iteration, set EMAIL_PROVIDER=smtp + SMTP_HOST=mailpit
# and start the compose stack with WITH_MAILPIT=1; emails are caught at
# http://localhost:8025 instead of being delivered.
EMAIL_PROVIDER=cloudflare              # cloudflare | resend | sendgrid | smtp
EMAIL_FROM=noreply@example.com

# --- cloudflare (primary) ----------------------------------------------
# Requires Workers Paid plan + Cloudflare-managed DNS for the sending
# domain. Endpoint is account-scoped, so BOTH vars are required in prod:
#   https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/email/sending/send
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=            # API token with "Email Sending: Edit"

# --- resend (alternate) ------------------------------------------------
# RESEND_API_KEY=
# whsec_… signing secret for the bounce/complaint webhook at
# /api/v1/webhooks/resend. Empty disables the route (503).
# RESEND_WEBHOOK_SECRET=

# --- sendgrid (alternate) ----------------------------------------------
# SENDGRID_API_KEY=
# PEM-encoded ECDSA P-256 public key from SendGrid's Signed Event Webhook.
# Required for the bounce/complaint webhook at /api/v1/webhooks/sendgrid.
# SENDGRID_WEBHOOK_PUBLIC_KEY=

# --- smtp (Mailpit / Postfix / etc.) -----------------------------------
# Use SMTP_HOST=mailpit + SMTP_PORT=1025 to point at the local catcher
# (compose `WITH_MAILPIT=1`). Auth is optional — Mailpit accepts any.
# SMTP_HOST=
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=

# Optional link rendered in the email footer.
NOTIFICATION_SETTINGS_URL=

# OAuth providers — only the ones with credentials configured are exposed.
# Missing creds → 404 from /auth/oauth/<provider>. State + PKCE are stored
# in Valkey (uses the VALKEY_* settings below; required when any OAuth
# provider is enabled).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# AI provider. AI_PROVIDER=openai uses the OpenAI v1 chat-completions wire
# format — point OPENAI_BASE_URL at any compatible endpoint to swap providers
# without touching code:
#
#   OpenAI       OPENAI_BASE_URL=                              (omit; default)
#   OpenRouter   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama       OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_API_KEY=ollama
#   LM Studio    OPENAI_BASE_URL=http://localhost:1234/v1
#   vLLM / TGI   OPENAI_BASE_URL=http://localhost:8000/v1
#   Together     OPENAI_BASE_URL=https://api.together.xyz/v1
#   Groq         OPENAI_BASE_URL=https://api.groq.com/openai/v1
#
# AI_PROVIDER=anthropic uses the native Messages API.
AI_ENABLED=false
AI_PROVIDER=openai                     # openai | anthropic | noop
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional JSON object of extra headers (OpenRouter ranking, custom auth):
# OPENAI_DEFAULT_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"My App"}
OPENAI_DEFAULT_HEADERS=
ANTHROPIC_API_KEY=

# Domain claiming for B2B mode. When true, the first verified signup with a
# non-public email domain (gmail.com / outlook.com / etc. are excluded) claims
# that domain on its personal account; subsequent signups from the same domain
# fail with `DOMAIN_CLAIMED` and must be invited by the existing account's
# admin. Leave false for consumer products.
ACCOUNT_DOMAIN_CLAIMING=false

# Billing (Stripe). The STRIPE_* keys are required only when BILLING_ENABLED=true.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_FREE=
STRIPE_PRICE_ID_PRO=

# Queues (BullMQ) + cache. The VALKEY_* + provider keys are required
# only when the relevant feature flag is true. QUEUES_ENABLED must be
# true in production so transactional email retries on transient
# provider failures; the validator fails boot otherwise.
QUEUES_ENABLED=true
CACHE_ENABLED=true
CACHE_PROVIDER=valkey                  # memory | valkey
NOTIFICATIONS_SSE_ENABLED=true         # true requires Valkey

# Web Push (VAPID). All three required together to enable the channel.
# In compose dev, the keypair is generated automatically on first
# `./dev.sh up -d` by infra/compose/scripts/dev-vapid-init.sh and
# written into compose/.env. For bare-bun local dev, generate manually:
#   bun run vapid:generate >> .env.local
# Subject is typically mailto:notifications@<your-domain>.
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
WEB_PUSH_VAPID_SUBJECT=

VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0

# Optional. Override only if you copy the precompiled email templates
# (src/templates/email/dist) to a non-default location in your image.
# EMAIL_TEMPLATES_DIR=/app/src/templates/email/dist
