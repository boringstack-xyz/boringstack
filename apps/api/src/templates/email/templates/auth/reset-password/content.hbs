<p style="margin: 0 0 24px; color: #E8E8E8; font-size: 16px; line-height: 1.6;">
  You requested a password reset. Click the button below to create a new
  password.
</p>

<!-- CTA Button -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
>
  <tr>
    <td align="center" style="padding: 8px 0 24px;">
      <a
        href="{{resetUrl}}?token={{token}}"
        style="display: inline-block; background-color: #4A90E2; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 6px; font-size: 15px; font-weight: 500; letter-spacing: 0.2px;"
      >
        Reset Password
      </a>
    </td>
  </tr>
</table>

<p style="margin: 24px 0 0; color: #808080; font-size: 14px; line-height: 1.5;">
  If you didn't request this, ignore this email. Your password remains
  unchanged.
</p>

{{#if dashboardUrl}}
  <p style="margin: 0; color: #808080; font-size: 14px; line-height: 1.5;">
    Manage your account settings in your
    <a
      href="{{dashboardUrl}}"
      style="color: #4A90E2; text-decoration: none;"
    >dashboard</a>.
  </p>
{{/if}}