<p style="margin: 0 0 24px; color: #E8E8E8; font-size: 16px; line-height: 1.6;">
  Confirm your email to complete your account setup.
</p>

<!-- CTA Button -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
>
  <tr>
    <td align="center" style="padding: 8px 0 24px;">
      <a
        href="{{confirmationUrl}}?token={{token}}"
        style="display: inline-block; background-color: #4A90E2; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 6px; font-size: 15px; font-weight: 500; letter-spacing: 0.2px;"
      >
        Confirm Email
      </a>
    </td>
  </tr>
</table>

<p style="margin: 0; color: #808080; font-size: 14px; line-height: 1.5;">
  If you didn't create this account, you can safely ignore this email.
</p>