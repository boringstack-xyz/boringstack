<p style="margin: 0 0 24px; color: #E8E8E8; font-size: 16px; line-height: 1.6;">
  Hi {{firstName}}, thanks for signing up. This is a placeholder note from the
  example follow-up; replace it with your own copy.
</p>

<!-- CTA Button -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
>
  <tr>
    <td align="center" style="padding: 8px 0 24px;">
      <a
        href="{{ctaUrl}}"
        style="display: inline-block; background-color: #15803d; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 6px; font-size: 15px; font-weight: 500; letter-spacing: 0.2px;"
      >
        {{ctaText}}
      </a>
    </td>
  </tr>
</table>

<p style="margin: 24px 0 0; color: #808080; font-size: 14px; line-height: 1.5;">
  {{#if canReply}}Just reply to this email if you have a question.{{/if}}
  <a
    href="{{unsubscribeUrl}}"
    style="color: #4ade80; text-decoration: none;"
  >Stop these emails</a>.
</p>
