<!-- Footer -->
<tr>
    <td
        style="padding: 24px 40px; background-color: #1a1a1a; border-top: 1px solid #3A3A3A; border-radius: 0 0 8px 8px;"
    >
        <table
            role="presentation"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="margin: 0 auto 20px;"
        >
            <tr>
                <td
                    style="width: 30px; height: 1px; background-color: transparent;"
                ></td>
                <td
                    style="width: 60px; height: 1px; background-color: #4A90E2;"
                ></td>
                <td
                    style="width: 30px; height: 1px; background-color: transparent;"
                ></td>
            </tr>
        </table>
        <p
            style="margin: 0 0 8px; color: #808080; font-size: 12px; line-height: 1.5; text-align: center; letter-spacing: 0.3px;"
        >
            {{appName}} Team
        </p>
        {{#if notificationSettingsUrl}}
        <p
            style="margin: 0; color: #808080; font-size: 11px; line-height: 1.5; text-align: center;"
        >
            <a
                href="{{notificationSettingsUrl}}"
                style="color: #4A90E2; text-decoration: none;"
            >Notification settings</a>
        </p>
        {{/if}}
    </td>
</tr>
