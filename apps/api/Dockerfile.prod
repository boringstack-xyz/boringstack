# Multi-stage build for production. Plain `docker build` works — no BuildKit
# required. If you have BuildKit available, you can wrap the bun install
# RUN in `--mount=type=cache,target=/root/.bun/install/cache` for faster
# rebuilds; we keep the portable version here.
FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS builder

WORKDIR /app

# HUSKY=0 makes the `prepare` script a no-op. devDeps aren't installed in
# --production mode, so `husky` would not be on PATH otherwise.
ENV HUSKY=0

COPY package.json bun.lock* ./

RUN bun install --frozen-lockfile --production

COPY . .

# Builds the email-template JSONs into src/templates/email/dist/, then bundles
# the API into /app/dist. Both are needed at runtime.
RUN bun run build

# Migration image (`--target migrations`): drizzle-kit is a devDependency, so it
# is installed here and kept out of the lean runtime image. The Kubernetes
# migration Job runs it. This stage must stay before `production`: a plain
# `docker build` builds the last stage, and that must be the API.
FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS migrations

RUN apk add --no-cache dumb-init

RUN addgroup -g 1001 -S nodejs && \
    adduser -S app -u 1001 -G nodejs

WORKDIR /app

ENV HUSKY=0

COPY package.json bun.lock* ./

RUN bun install --frozen-lockfile

# Only what `db:migrate` reads: the drizzle config, the SQL history, and the
# env/connection modules the config imports for the shared TLS policy.
COPY drizzle.config.ts ./
COPY drizzle ./drizzle
COPY src/lib/postgres/connection.ts ./src/lib/postgres/connection.ts
COPY src/config/env ./src/config/env

# Set after install so `bun install` above still sees devDependencies.
ENV NODE_ENV=production

RUN chown -R app:nodejs /app

USER app

ENTRYPOINT ["dumb-init", "--"]

CMD ["bun", "run", "db:migrate"]

# Production stage
FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS production

RUN apk add --no-cache dumb-init

# Non-root user (k8s-friendly fixed UID/GID). `oven/bun:1.4.2-alpine` ships
# with a `bun` user/UID 1000 already; we add our own at 1001 to avoid
# collisions and so prod images run as a deliberate, named user.
RUN addgroup -g 1001 -S nodejs && \
    adduser -S app -u 1001 -G nodejs

WORKDIR /app

COPY --from=builder --chown=app:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=app:nodejs /app/dist ./dist
COPY --from=builder --chown=app:nodejs /app/package.json ./
# Precompiled email templates loaded at runtime by EmailTemplateService.
COPY --from=builder --chown=app:nodejs /app/src/templates/email/dist ./src/templates/email/dist

RUN mkdir -p /app/logs && chown -R app:nodejs /app

USER app

EXPOSE 7330

ENV NODE_ENV=production
ENV BUN_ENV=production

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:7330/health || exit 1

ENTRYPOINT ["dumb-init", "--"]

# --no-install: bun must never try to install packages at startup. Production
# root filesystems are read-only (readOnlyRootFilesystem), so an install attempt
# crashes with EROFS. Writable scratch space is /tmp, mounted by the manifests.
CMD ["bun", "--no-install", "run", "dist/index.js"]
