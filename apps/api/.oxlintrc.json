{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["eslint", "import", "promise", "typescript", "unicorn"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "drizzle",
    "*.config.js",
    "src/templates/email/dist/**",
    "src/templates/email/preview/**",
    "tests/lint-meta/fixtures/**"
  ],
  "rules": {},
  "overrides": [
    {
      "files": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "security-spec/**/*.ts",
        "scripts/**/*.ts"
      ],
      "rules": {
