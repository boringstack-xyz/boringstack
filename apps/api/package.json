{
  "name": "boringstack-api",
  "version": "0.1.0",
  "description": "Production-ready Bun + Elysia + Drizzle API starter template",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "test": "bun run build:templates && NODE_ENV=test bun run scripts/quality/run-tests-clean.ts",
    "test:coverage": "bun run build:templates && NODE_ENV=test bun run scripts/quality/check-coverage.ts",
    "dev": "./scripts/dev/preflight-host-dev.sh && bun run build:templates && bun run --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/db/seed-superuser.ts",
    "db:studio": "drizzle-kit studio",
    "build:templates": "bun run src/templates/email/build.ts",
    "build:templates:watch": "bun run src/templates/email/build.ts --watch",
    "preview:templates": "bun run src/templates/email/preview.ts",
    "build": "bun run build:templates && bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "lint:meta": "bun run scripts/lint-meta/cli.ts",
    "lint:meta:verify": "bun run scripts/lint-meta/cli.ts --verify",
    "generate:lint-meta-docs": "bun run scripts/lint-meta/generate-rules-md.ts",
    "check:lint-meta-docs": "bun run scripts/lint-meta/generate-rules-md.ts --check",
    "check:scripts-docs": "bun run scripts/check-scripts-docs.ts",
    "check": "bun run typecheck && bun run lint && bun run lint:meta && bun run check:lint-meta-docs && bun run knip",
    "validate": "bun run check && bun run test",
    "new:resource": "bun run scripts/codegen/new-resource.ts",
    "vapid:generate": "bun run scripts/codegen/vapid-generate.ts",
    "new:notification-event": "bun run scripts/codegen/new-notification-event.ts",
    "new:action": "bun run scripts/codegen/new-action.ts",
    "new:role": "bun run scripts/codegen/new-role.ts",
    "new:subject": "bun run scripts/codegen/new-subject.ts",
    "new:feature": "bun run scripts/codegen/new-feature.ts",
    "generate:acl-types": "bun run scripts/codegen/generate-acl-types.ts",
    "generate:acl-types:check": "bun run scripts/codegen/generate-acl-types.ts --check",
    "pre-push": "./scripts/ci/pre-push.sh",
    "loadtest": "./scripts/loadtest/run.sh",
    "prepare": "husky 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.97.1",
    "@casl/ability": "6.8.1",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/jwt": "1.4.2",
    "@elysiajs/swagger": "1.3.1",
    "@sendgrid/mail": "8.1.6",
    "@sentry/bun": "10.53.1",
    "@sinclair/typebox": "0.34.49",
    "arctic": "3.7.0",
    "bullmq": "5.76.10",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.28",
    "elysia-rate-limit": "4.6.2",
    "fs-extra": "11.3.5",
    "handlebars": "4.7.9",
    "ioredis": "5.10.1",
    "nodemailer": "8.0.7",
    "openai": "6.38.0",
    "pg": "8.21.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.9",
    "prom-client": "^15.1.3",
    "resend": "6.12.3",
    "stripe": "22.1.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@boring-stack-pkg/eslint-plugin-audit-log": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-bullmq": "0.1.3",
    "@boring-stack-pkg/eslint-plugin-cache-keys": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-code-flow": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-comment-hygiene": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-db-transactions": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-drizzle-conventions": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-elysia": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-env-access": "0.1.3",
    "@boring-stack-pkg/eslint-plugin-jwt-cookies": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-module-boundaries": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-oauth-security": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-resource-architecture": "0.2.0",
    "@boring-stack-pkg/eslint-plugin-stripe-webhooks": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-structured-logging": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-test-conventions": "0.1.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint/js": "10.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/nodemailer": "8.0.0",
    "@types/pg": "8.20.0",
    "@types/web-push": "3.6.4",
    "bun-types": "1.3.14",
    "chokidar": "5.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-unicorn": "64.0.0",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "knip": "6.14.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0"
  },
  "overrides": {
    "@typescript-eslint/utils": "8.60.0"
  }
}
