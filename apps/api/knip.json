{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.ts",
    "src/**/index.ts",
    "tests/**/*.test.ts",
    "src/lib/ai/providers/**/index.ts",
    "security-spec/**/*.test.ts"
  ],
  "project": [
    "src/**/*.ts!",
    "tests/**/*.ts",
    "!tests/lint-meta/fixtures/**",
    "scripts/**/*.ts",
    "security-spec/**/*.ts"
  ],
  "include": [
    "files",
    "dependencies",
    "unlisted"
  ],
  "ignore": [
    "tests/setup-test-env.ts"
  ]
}
