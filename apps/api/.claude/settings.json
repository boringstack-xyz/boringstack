{
  "$schema": "https://docs.claude.com/schemas/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    },
    "ghostsecurity": {
      "source": {
        "source": "github",
        "repo": "ghostsecurity/skills"
      }
    }
  },
  "enabledPlugins": {
    "differential-review@trailofbits": true,
    "insecure-defaults@trailofbits": true,
    "static-analysis@trailofbits": true,
    "supply-chain-risk-auditor@trailofbits": true,
    "fp-check@trailofbits": true,
    "sharp-edges@trailofbits": true,
    "ghost-validate@ghostsecurity": true,
    "ghost-scan-code@ghostsecurity": true
  }
}
