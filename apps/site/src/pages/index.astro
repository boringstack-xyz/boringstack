---
import BaseLayout from "../layouts/BaseLayout.astro";
import { appHref, siteConfig } from "../lib/site-config";
import { siteName, siteTagline } from "../lib/site";

const features = [
  {
    title: "An isolated stack per agent",
    body: "Each change gets its own worktree, branch and database stack, so agents never share a port or a database.",
  },
  {
    title: "A gate agents cannot skip",
    body: "The verify gate checks what changed, a hook keeps the session working until it passes, and each change ships with a record of what was not verified.",
  },
  {
    title: "Agents you steer from your phone",
    body: "Run agents in the cloud or on your own always-on host, and follow them from the Claude app. Nothing merges until a person decides.",
  },
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteName,
    url: siteConfig.siteUrl,
    logo: `${siteConfig.siteUrl}/brand-mark.svg`,
    ...(siteConfig.contactEmail ? { email: siteConfig.contactEmail } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: siteConfig.siteUrl,
  },
];
---

<BaseLayout
  title={siteName}
  description={siteTagline}
  structuredData={structuredData}
>
  <section class="hero hero-top">
    <h1>
      {siteName}: a production-grade template with its own software factory
    </h1>
    <p>
      {siteTagline} Auth, billing, queues, email and observability are already
      wired. Agents build each change in an isolated stack, and a person decides
      every merge.
    </p>
    <a class="button" href={appHref("/signup")}>
      Create an account
    </a>
  </section>

  <section aria-labelledby="features-heading">
    <h2 id="features-heading">Features</h2>
    <div class="cards">
      {features.map((feature) => (
        <article class="card">
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="cta-heading">
    <h2 id="cta-heading">Ready to start?</h2>
    <p>
      Set up a project with one command, then point your agent at it:
      <code>
        curl -fsSL https://boringstack.xyz/install.sh | sh -s -- --project acme
      </code>
    </p>
    <a class="button" href={appHref("/signup")}>
      Sign up
    </a>
    <a class="button button-secondary gap-start" href="/pricing">
      See pricing
    </a>
  </section>
</BaseLayout>
