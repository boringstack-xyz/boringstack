# Rendered by scripts/render-nginx.mjs at image build time. __CSP__ is the only
# substituted value. Runs as a non-root user with a read-only root filesystem:
# every writable path lives under /tmp, which the orchestrator mounts as a
# tmpfs or emptyDir.
worker_processes auto;
pid /tmp/nginx/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  charset utf-8;
  access_log /dev/stdout;
  sendfile on;
  server_tokens off;

  client_body_temp_path /tmp/nginx/client_temp;
  proxy_temp_path /tmp/nginx/proxy_temp;
  fastcgi_temp_path /tmp/nginx/fastcgi_temp;
  uwsgi_temp_path /tmp/nginx/uwsgi_temp;
  scgi_temp_path /tmp/nginx/scgi_temp;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_comp_level 5;
  gzip_types text/css application/javascript application/json application/xml image/svg+xml text/plain;

  # Hashed build assets are immutable. Successful pages and images get a short
  # cache. HTML and every error response are revalidated or never stored, so a
  # republished page is never served stale.
  map "$status:$uri" $cache_control {
    default "no-cache";
    ~^[45][0-9][0-9]: "no-store";
    ~^200:/_astro/ "public, max-age=31536000, immutable";
    ~^200:.*\.(?:png|jpe?g|webp|svg|ico|woff2?)$ "public, max-age=86400";
  }

  server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;

    # add_header inside a location replaces every server-level header, so the
    # security headers are declared here only and no location adds its own.
    # HSTS is set by the ingress, which terminates TLS.
    add_header Content-Security-Policy "__CSP__" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cache-Control $cache_control always;

    # Readiness and liveness. Kept off the access log.
    location = /healthz {
      access_log off;
      default_type text/plain;
      return 200 "ok\n";
    }

    # Hidden files and directories are never served.
    location ~ /\.(?!well-known) {
      deny all;
    }

    # Canonical URLs are slashless and extensionless. Redirect the alternatives.
    location = /index.html {
      return 301 /;
    }
    location ~ ^/(.+)/index\.html$ {
      return 301 /$1$is_args$args;
    }
    location ~ ^/(.+)\.html$ {
      return 301 /$1$is_args$args;
    }
    location ~ ^/(.+)/+$ {
      return 308 /$1$is_args$args;
    }

    location /_astro/ {
      try_files $uri =404;
    }

    location / {
      try_files $uri $uri.html $uri/index.html =404;
    }

    error_page 404 /404.html;
    location = /404.html {
      internal;
    }
  }
}
