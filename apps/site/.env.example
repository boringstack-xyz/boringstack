# Build-time configuration. Validated when Astro loads its config, so a bad
# value fails `astro build` (and `docker build`) instead of publishing pages.
# `bun run dev` supplies localhost defaults itself; see README.md.

# Public origin of this site (no path). https outside localhost.
SITE_URL=https://boringstack.example.com
# Origin of the app (sign-up and sign-in links). Must differ from SITE_URL.
APP_URL=https://app.boringstack.example.com
# Required for a public-origin build. Shown on the contact page and in the
# structured data. Use a real mailbox you monitor.
CONTACT_EMAIL=hello@boringstack.example.com

# Optional, off by default. Both or neither. The script loads only after the
# visitor accepts analytics in the consent banner. Any provider that loads from
# ANALYTICS_SCRIPT_URL and reads a data-website-id attribute works.
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=
