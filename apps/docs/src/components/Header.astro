---
import config from "virtual:starlight/user-config";

import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";

const navLinkClass =
  "rounded-md px-3 py-2 text-[0.92rem] font-bold leading-none text-[var(--sl-color-gray-2)] no-underline transition-colors hover:bg-white/[0.05] hover:text-[var(--sl-color-white)]";

const navItems = [
  { href: "/quickstart/", label: "Quickstart" },
  { href: "/architecture/why-boringstack/", label: "Why" },
  { href: "/architecture/decisions/", label: "Decisions" },
  { href: "/recipes/add-stripe/", label: "Recipes" },
  { href: "/topics/deployment/", label: "Deploy" },
  { href: "/reference/commands/", label: "Reference" },
];
---

<div
  class="grid h-full w-full max-w-full grid-cols-[auto_auto_minmax(15rem,28rem)_1fr] items-center gap-[1.2rem] [html[data-has-hero]_&]:mx-auto [html[data-has-hero]_&]:w-[min(1360px,calc(100vw-2rem))] max-[74rem]:grid-cols-[auto_minmax(12rem,1fr)_auto] max-[50rem]:grid-cols-[auto_1fr] max-[50rem]:gap-3"
>
  <a
    class="inline-flex items-center gap-2.5 whitespace-nowrap text-[var(--sl-color-white)] no-underline"
    href="/"
    aria-label="BoringStack home"
  >
    <svg
      class="h-[30px] w-[30px] shrink-0 text-[var(--sl-color-accent)]"
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="square"
      stroke-linejoin="miter"
    >
      <rect x="3" y="6" width="18" height="12" />
      <line x1="6" y1="9.5" x2="13" y2="9.5" />
      <line x1="6" y1="12" x2="13" y2="12" />
      <line x1="6" y1="14.5" x2="13" y2="14.5" />
      <rect x="16.5" y="11" width="2" height="2" fill="currentColor" stroke="none" />
    </svg>
    <span class="font-extrabold leading-none">BoringStack</span>
  </a>

  <nav class="flex items-center gap-1 max-[74rem]:hidden" aria-label="Primary">
    {
      navItems.map((item) => (
        <a class={navLinkClass} href={item.href}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="min-w-0 print:hidden max-[50rem]:justify-self-end">
    {shouldRenderSearch && <Search />}
  </div>

  <div
    class="sl-hidden items-center justify-end justify-self-end gap-3 print:hidden before:h-7 before:w-px before:bg-[var(--sl-color-gray-5)] before:content-[''] md:sl-flex"
  >
    <a
      class="inline-flex items-center gap-1.5 rounded-md border border-[var(--sl-color-gray-5)] bg-[rgba(74,222,128,0.06)] px-2.5 py-1.5 text-[0.85rem] font-bold leading-none text-[var(--sl-color-white)] no-underline transition-colors hover:border-[color-mix(in_srgb,var(--sl-color-accent)_62%,transparent)] hover:bg-[color-mix(in_srgb,var(--sl-color-accent)_18%,transparent)]"
      href="https://github.com/boringstack-xyz/boringstack"
      rel="noopener noreferrer"
      target="_blank"
      aria-label="Star BoringStack on GitHub"
    >
      <svg
        class="h-[1rem] w-[1rem]"
        aria-hidden="true"
        viewBox="0 0 16 16"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
        />
      </svg>
      <span class="max-[60rem]:sr-only">Star</span>
    </a>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>
