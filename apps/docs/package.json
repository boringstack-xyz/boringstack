{
  "name": "boringstack-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "boringstack.xyz docs site for the BoringStack project. Astro Starlight, deployed via Cloudflare Pages.",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "generate:lint-meta-docs": "node scripts/generate-lint-meta-docs.mjs",
    "generate:scripts-docs": "node scripts/generate-scripts-docs.mjs",
    "generate:docs-data": "bun run generate:lint-meta-docs && bun run generate:scripts-docs",
    "check:lint-meta-docs": "node scripts/generate-lint-meta-docs.mjs --check",
    "check:scripts-docs": "node scripts/generate-scripts-docs.mjs --check",
    "check:docs-data": "bun run check:lint-meta-docs && bun run check:scripts-docs",
    "build:site": "astro build",
    "build": "astro build",
    "build:ci": "bun run check:docs-data && astro build",
    "preview": "bun run build:site && wrangler dev",
    "astro": "astro",
    "deploy": "bun run build:ci && wrangler deploy",
    "cf-typegen": "wrangler types",
    "a11y": "bash scripts/a11y.sh"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12",
    "@astrojs/react": "^5.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/starlight": "^0.36.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^5.16.0",
    "astro-mermaid": "^2.0.1",
    "clsx": "^2.1.1",
    "mermaid": "11.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reading-time": "^1.5.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.3",
    "http-server": "^14.1.1",
    "starlight-llms-txt": "0.6.1",
    "wrangler": "4.87.0"
  },
  "overrides": {
    "ws@<8.20.1": "^8.20.1"
  }
}
