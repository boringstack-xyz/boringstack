# --- App ---
# Public name shown in <title>, errors, emails-from-UI, etc.
VITE_APP_NAME="AI Starter UI"

# Base URL the BROWSER uses to reach the API.
# Leave empty for same-origin + Vite dev-server proxy (recommended in docker-compose).
# Set to a full URL when the API is on a different origin (e.g. https://api.example.com).
VITE_API_URL=

# Dev-only: where the Vite dev server forwards /api requests to. Ignored in prod builds.
# In docker-compose this is the API service hostname (e.g. http://api-dev:3000);
# outside compose it's typically http://localhost:3000.
VITE_API_PROXY_TARGET=http://localhost:3000

# Production URL — used by SEO, OAuth redirect URIs, share links.
VITE_PUBLIC_URL=http://localhost:3001

# --- Observability ---
# Sentry DSN — leave empty to disable in dev.
VITE_SENTRY_DSN=

# --- Auth ---
# Storage key namespace for any non-sensitive auth state (e.g., last-route memory).
# Tokens themselves live in HTTP-only cookies set by the API; never write them here.
# OAuth provider buttons are driven by GET /api/v1/capabilities — configure
# GOOGLE_OAUTH_*, GITHUB_OAUTH_*, and LINKEDIN_OAUTH_* on the API only.
VITE_AUTH_NAMESPACE=ui-template

# --- Web Push ---
# VAPID public key used by the browser when subscribing to push. Generate
# the keypair with `bun run vapid:generate` in api-template; paste the
# PUBLIC half here (must match API WEB_PUSH_VAPID_PUBLIC), keep the PRIVATE
# half on the server. The API must also have all three WEB_PUSH_VAPID_* vars
# set — the UI reads `capabilities.features.notifications.webPush` as well.
# Empty disables the Web Push subscribe UI.
VITE_VAPID_PUBLIC_KEY=

# --- i18n ---
# Comma-separated locales the bundle supports. The first one is the default.
VITE_LOCALES=en,de
