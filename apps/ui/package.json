{
  "name": "ui-template",
  "version": "0.1.0",
  "description": "Production-grade SPA starter (Vite + React + TypeScript) for the BoringStack family. Wired with shadcn/ui, TanStack Query, Zustand, react-router, RHF + Zod, i18next, Storybook, Playwright, and 8 custom ESLint plugins enforcing the architecture.",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.13",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "bun": "1.3.13"
  },
  "scripts": {
    "dev": "./scripts/dev/preflight-host-dev.sh && vite",
    "dev:docker": "vite",
    "build": "vite build && (cp _headers dist/ 2>/dev/null || true)",
    "preview": "vite preview",
    "validate": "bun run check && bun run test:ci && bun run build && bun run size:check && bun run size:check:modulepreload",
    "validate:full": "bun run validate && bun run e2e:ci",
    "size:check": "size-limit",
    "size:check:modulepreload": "tsx scripts/quality/check-modulepreload-size-coverage.ts",
    "size:why": "size-limit --why",
    "analyze": "ANALYZE=true bun run build && open dist/stats.html",
    "lighthouse": "bun run build && lhci autorun",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run validate && changeset tag && git push --follow-tags",
    "check": "bun run lint && bun run lint:meta && bun run check:lint-meta-docs && bun run format:check && bun run typecheck && bun run knip",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "lint:meta": "tsx scripts/lint-meta/cli.ts",
    "lint:meta:verify": "tsx scripts/lint-meta/cli.ts --verify",
    "generate:lint-meta-docs": "tsx scripts/lint-meta/generate-rules-md.ts",
    "check:lint-meta-docs": "tsx scripts/lint-meta/generate-rules-md.ts --check",
    "check:scripts-docs": "tsx scripts/check-scripts-docs.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ci": "tsx scripts/quality/run-tests-clean.ts run --coverage",
    "e2e": "playwright test --grep-invert 'Visual regression'",
    "e2e:ci": "playwright test --grep-invert 'Visual regression' --reporter=github,html",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps",
    "e2e:visual": "playwright test e2e/visual.spec.ts --project=chromium",
    "e2e:visual:update": "playwright test e2e/visual.spec.ts --project=chromium --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ui:add": "shadcn add",
    "new:component": "tsx scripts/codegen/new-component.ts",
    "new:feature": "tsx scripts/codegen/new-feature.ts",
    "generate:api": "tsx scripts/codegen/generate-api.ts",
    "generate:api:check": "tsx scripts/codegen/generate-api.ts --check",
    "pre-push": "./scripts/ci/pre-push.sh",
    "prepare": "husky 2>/dev/null || true"
  },
  "dependencies": {
    "@casl/ability": "6.8.1",
    "@casl/react": "5.0.1",
    "@hookform/resolvers": "5.2.2",
    "@sentry/react": "10.52.0",
    "@tanstack/react-query": "5.100.9",
    "@tanstack/react-query-devtools": "5.100.9",
    "class-variance-authority": "0.7.1",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "i18next": "26.0.10",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "1.14.0",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-helmet-async": "3.0.0",
    "react-hook-form": "7.75.0",
    "react-i18next": "17.0.7",
    "react-router-dom": "7.15.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@boring-stack-pkg/eslint-plugin-code-flow": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-comment-hygiene": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-env-access": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-i18n-keys": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-module-boundaries": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-react-component-architecture": "0.2.1",
    "@boring-stack-pkg/eslint-plugin-resource-architecture": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-structured-logging": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-tanstack-query-cache": "0.1.1",
    "@boring-stack-pkg/eslint-plugin-test-conventions": "0.1.1",
    "@changesets/cli": "2.31.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "1.2.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.59.1",
    "@sentry/vite-plugin": "5.2.1",
    "@size-limit/preset-app": "12.1.0",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-themes": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-unicorn": "64.0.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.11.0",
    "lint-staged": "17.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "rollup-plugin-visualizer": "7.0.1",
    "size-limit": "12.1.0",
    "storybook": "10.3.6",
    "tailwindcss": "4.3.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.0.11",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.5",
    "yaml": "2.9.0"
  }
}
