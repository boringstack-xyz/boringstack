# Supply-chain protection. Refuses to install package versions younger than
# the threshold below, on the theory that a compromised publish gets caught
# and yanked within a few days. 10080 minutes = 7 days.
# https://pnpm.io/settings#minimum-release-age
minimum-release-age=10080

# Exclusions for high-traffic, low-risk packages whose latest release
# routinely falls inside the 7-day window and would otherwise block any
# install. Add a package here only if the marginal safety from the quarantine
# is small relative to the friction of every install failing.
minimum-release-age-exclude[]=yaml
minimum-release-age-exclude[]=@tailwindcss/oxide*
minimum-release-age-exclude[]=@tailwindcss/oxide
# First-party packages we publish ourselves don't need the 7-day quarantine.
minimum-release-age-exclude[]=@boring-stack-pkg/eslint-plugin-code-flow
minimum-release-age-exclude[]=@boring-stack-pkg/eslint-plugin-comment-hygiene
minimum-release-age-exclude[]=@boring-stack-pkg/eslint-plugin-env-access
minimum-release-age-exclude[]=@boring-stack-pkg/eslint-plugin-i18n-keys
minimum-release-age-exclude[]=@boring-stack-pkg/eslint-plugin-module-boundaries
minimum-release-age-exclude[]=@boring-stack-pkg/eslint-plugin-react-component-architecture
minimum-release-age-exclude[]=@boring-stack-pkg/eslint-plugin-resource-architecture
minimum-release-age-exclude[]=@boring-stack-pkg/eslint-plugin-structured-logging
minimum-release-age-exclude[]=@boring-stack-pkg/eslint-plugin-tanstack-query-cache
minimum-release-age-exclude[]=@boring-stack-pkg/eslint-plugin-test-conventions

# Hoist pattern: keep types reachable from the workspace root for IDE
# resolution without flattening the rest of the dependency tree.
# (Default for new pnpm repos; pinning explicitly to avoid surprises.)
hoist=true
