# Copy to compose/api.prod.env and fill EVERY blank below before:
#   STACK=prod ./scripts/compose-up.sh
#
# DATABASE_URL / VALKEY_* / PORT are wired in docker-compose.yml.
#
# The api boots with NODE_ENV=production. Its env validator rejects:
#   - empty required secrets (JWT_SECRET, MFA_ENCRYPTION_KEY)
#   - obvious placeholder strings (replace-with-*, change-me-*, *placeholder*)
#   - EMAIL_FROM on an example.com / localhost domain
# A misconfigured deploy fails loud at boot, not silently with a known
# secret. Do not commit this file once filled — secrets live in your
# secret manager, not the repo.

# --- Auth secrets ------------------------------------------------------
# Generate fresh values for every deploy. Never reuse a JWT_SECRET across
# environments; rotation invalidates every active session.
#   JWT_SECRET:           openssl rand -base64 48
#   MFA_ENCRYPTION_KEY:   openssl rand -base64 32  (cannot be rotated
#                         after users enrol in MFA — the v1$ prefix on
#                         ciphertexts is for a future migration path)
JWT_SECRET=
MFA_ENCRYPTION_KEY=

# --- Public URLs -------------------------------------------------------
# Same-origin deploy (default): FRONTEND_URL and PUBLIC_API_URL point at
# the same host, Traefik path-routes /api/* to the api and everything
# else to the ui. ALLOWED_ORIGINS stays empty (CORS not mounted).
# Cross-origin deploy: set ALLOWED_ORIGINS to the SPA's HTTPS origin(s)
# (CSV, no wildcards).
FRONTEND_URL=https://app.example.com
PUBLIC_API_URL=https://app.example.com
ALLOWED_ORIGINS=

# --- Email — Cloudflare Email Service (default) ----------------------
# Setup runbook: /runbooks/cloudflare-email-setup
# EMAIL_FROM must be on a domain you control and have verified with the
# provider. The validator rejects example.com / localhost in production.
EMAIL_PROVIDER=cloudflare
EMAIL_FROM=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# Other features (OAuth, Stripe, observability, web push, AI) inherit
# their env from apps/api/.env.example. Copy the lines you need; the
# validator enforces "all-or-nothing" pairs (e.g. GOOGLE_OAUTH_CLIENT_ID
# without CLIENT_SECRET fails boot).
