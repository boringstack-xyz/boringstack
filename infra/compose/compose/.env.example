# Copy to compose/.env (see .gitignore). Used by compose/dev.sh.
#
# Dev DX: browser hits Vite at http://localhost:7331 and Vite's dev-server
# proxy forwards /api/* to the api-dev container over the docker network.
# Same-origin from the browser's perspective — no CORS preflights, no
# `.localhost` subdomains, no Traefik in dev.
#
# Prod routing: Traefik on the apex domain path-routes /api/* + /health to
# the api container, everything else to the ui container. One TLS cert,
# one host, same-origin everywhere.

# dev | prod (which Compose overlay to merge)
STACK=dev

# Postgres / Valkey (base stack)
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=app

# Production overlay only: real DNS name for ACME + Traefik router.
# The SPA is built domain-agnostic (VITE_API_URL=""), so this single host
# serves both the UI and /api/* in same-origin mode.
PUBLIC_UI_HOST=example.com
ACME_EMAIL=you@example.com

# Required in prod (STACK=prod). Compose fails boot with a clear error if
# any are unset. Generate JWT_SECRET with `openssl rand -base64 48`.
# Generate MFA_ENCRYPTION_KEY with `openssl rand -base64 32`.
# JWT_SECRET=
# MFA_ENCRYPTION_KEY=
# FRONTEND_URL=https://example.com
# PUBLIC_API_URL=https://example.com         # origin only — the SPA appends /api/v1 itself
# ALLOWED_ORIGINS=   # leave empty for same-origin; set if exposing api cross-origin

# GHCR image source. Defaults point at the canonical upstream images. If you
# clicked "Use this template" on GitHub, set these to your fork:
#
#   IMAGE_OWNER       — your GitHub org or user (lowercase). Always set after fork.
#   API_IMAGE_NAME    — API image package (default: boringstack-api).
#   UI_IMAGE_NAME     — UI image package  (default: boringstack-ui).
#   API_IMAGE_TAG     — default `latest`; pin to a sha-<7> or semver for prod.
#   UI_IMAGE_TAG      — same.
#
# IMAGE_OWNER=boringstack-xyz
# API_IMAGE_NAME=boringstack-api
# UI_IMAGE_NAME=boringstack-ui
# API_IMAGE_TAG=latest
# UI_IMAGE_TAG=latest
#
# Alternatively, override the full image reference (skips the assembly above):
# API_IMAGE=ghcr.io/me/my-saas-api:0.3.0
# UI_IMAGE=ghcr.io/me/my-saas-ui:0.5.1

# Optional: explicit origin baked into the SPA prod build. Leave unset for
# same-origin (the SPA uses relative `/api/*`). Override only if you deploy
# the API on a different host (cross-origin) and also set ALLOWED_ORIGINS
# in api.prod.env. ORIGIN ONLY — no path suffix. The SPA appends `/api/v1`
# itself, so `https://example.com/api` would produce `/api/api/v1/...`.
# PUBLIC_API_URL=https://api.example.com

# --- Observability (Grafana + Prometheus + Loki + Tempo) ----------------
# On by default for dev + prod (`./dev.sh up`). Disable with WITH_OBSERVABILITY=0.
# Grafana lives on host port 3010 once the stack is up.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Tempo (distributed tracing) receives OTLP spans from the API. The api-dev
# and api services default to `http://tempo:4318` over the shared backend
# network when the observability stack is on. Override to point at a
# different collector, or set empty to disable trace export entirely.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# OTEL_SERVICE_NAME=boringstack-api          # shows up as `service.name` in Tempo

# --- Alertmanager receivers (optional) ----------------------------------
# Alertmanager runs as part of observability and the bundled rules.yml
# fires alerts on API 5xx spikes, Postgres health, disk/memory pressure,
# etc. Without a receiver URL set, alerts surface in the Alertmanager UI
# only (http://localhost:9093 in dev). Set either or both of:
#
# Slack-format webhook. Discord also accepts Slack format — paste your
# Discord webhook URL with `/slack` appended (e.g.
# https://discord.com/api/webhooks/.../slack) to route alerts there.
# ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# ALERTMANAGER_SLACK_CHANNEL=#alerts
#
# Generic webhook receiving Alertmanager's native JSON. Use for custom
# bridges (n8n, your own alerter, PagerDuty's events-v2 API, etc.).
# ALERTMANAGER_WEBHOOK_URL=https://...
#
# See docs/alerts.md for receiver-specific setup walkthroughs.

# Optional (dev profile): override api-dev defaults from docker-compose.yml.
# Default is same-origin via Vite proxy — leave these unset unless you're
# exposing the api across origins (e.g., curl from a different host).
# API_DEV_JWT_SECRET=...   # min 32 characters
# API_DEV_MFA_ENCRYPTION_KEY=...   # base64 32 bytes; `openssl rand -base64 32`. Dev gets a placeholder; prod must override.
# API_DEV_FRONTEND_URL=http://localhost:7331
# API_DEV_ALLOWED_ORIGINS=
# API_DEV_PUBLIC_API_URL=http://localhost:7331/api

# Optional: first-boot superuser. Both must be set for the api-migrate
# one-shot to seed an admin account. THIS FILE is the right place — the
# api-migrate service in docker-compose.yml reads `${SUPERUSER_EMAIL}` from
# here, NOT from apps/api/.env (Compose doesn't read it; an explicit
# empty default in the service overrides anything Bun's .env loader does
# inside the container). Uncomment to enable; rotate before going to prod.
# SUPERUSER_EMAIL=demo@example.com
# SUPERUSER_PASSWORD=password123

# --- GlitchTip — self-hosted error tracking ------------------------------
# On by default for dev + prod (`./dev.sh up`). Disable with WITH_GLITCHTIP=0.
# Reuses the base stack's Postgres (separate `glitchtip` DB) and Valkey
# (DB 1). See docs/glitchtip.md.
#
# Dev boots out-of-the-box: dev.sh seeds a dev-only SECRET_KEY if you don't
# set one, auto-creates an org + API/Frontend projects, and creates a
# superuser at admin@localhost / admin123456.
#
# Prod requires you to set these explicitly — `./dev.sh up` will fail
# loudly if GLITCHTIP_SECRET_KEY / GLITCHTIP_PUBLIC_HOST /
# GLITCHTIP_BASIC_AUTH_USERS are unset when STACK=prod:
# GLITCHTIP_SECRET_KEY=                       # `openssl rand -base64 50` — never commit
# GLITCHTIP_PUBLIC_HOST=glitchtip.example.com # DNS name for the GlitchTip router
# GLITCHTIP_BASIC_AUTH_USERS=user:$$apr1$$... # `htpasswd -nb user pass` (escape $ → $$)
# GLITCHTIP_EMAIL_URL=smtp://user:pass@smtp.example.com:587   # invite + alert emails
#
# Dev-only overrides (optional):
# GLITCHTIP_DOMAIN=http://glitchtip.localhost
# GLITCHTIP_DEFAULT_FROM_EMAIL=noreply@example.com
# GLITCHTIP_SUPERUSER_EMAIL=admin@localhost
# GLITCHTIP_SUPERUSER_PASSWORD=admin123456
# GLITCHTIP_DEFAULT_ORG_NAME=Local
# GLITCHTIP_DEFAULT_PROJECTS=API,Frontend
#
# DSNs — auto-wired by `scripts/glitchtip-fetch-dsn.sh`, which `dev.sh up -d`
# runs in the background on the dev stack. The script reads the DSNs from
# GlitchTip's Django ORM and writes them here, then restarts api-dev / ui-dev
# so they pick up the values. DSNs are public keys (they ship in the browser
# bundle), not secrets — safe to keep in this file even if it's committed.
# Set them by hand if you'd rather skip the auto-wire (or are pointing at
# hosted Sentry / a different GlitchTip):
# SENTRY_DSN=                         # consumed by api-dev (and api in prod)
# VITE_SENTRY_DSN=                    # consumed by ui-dev (and ui in prod build)

# --- Mailpit (optional, dev-only, WITH_MAILPIT=1) -----------------------
# Local SMTP catcher. Captures emails sent by the api when EMAIL_PROVIDER=smtp
# and SMTP_HOST=mailpit (configured in api.dev.env or compose/.env). Web UI
# at http://localhost:8025; SMTP on localhost:1025. No auth required.
# MAILPIT_LIMITS_CPUS=0.25
# MAILPIT_LIMITS_MEMORY=128M

# --- BullMQ dashboard (optional, dev-only, WITH_BULLMQ=1) ---------------
# Visualizes Bull / BullMQ jobs in the API app's Valkey. Reachable at
# http://bullmq.localhost or http://localhost:7332 once the overlay is on.
# BULL_PREFIX must match the API app's queue prefix (default: bull).
# BULL_PREFIX=bull

# --- Resource budgets ----------------------------------------------------
# Every service has limits + reservations with sane defaults sized for a
# 4-vCPU / 8 GB single-host (the dominant cheap-VPS target). Uncomment to
# override. See docs/resource-limits.md for sizing guidance.
#
# POSTGRES_LIMITS_CPUS=1.0
# POSTGRES_LIMITS_MEMORY=512M
# POSTGRES_RESERVATIONS_CPUS=0.25
# POSTGRES_RESERVATIONS_MEMORY=128M
#
# VALKEY_LIMITS_CPUS=0.5
# VALKEY_LIMITS_MEMORY=256M
# VALKEY_RESERVATIONS_CPUS=0.1
# VALKEY_RESERVATIONS_MEMORY=64M
#
# TRAEFIK_LIMITS_CPUS=0.5
# TRAEFIK_LIMITS_MEMORY=256M
# TRAEFIK_RESERVATIONS_CPUS=0.1
# TRAEFIK_RESERVATIONS_MEMORY=64M
#
# API_DEV_LIMITS_CPUS=1.5
# API_DEV_LIMITS_MEMORY=1G
# API_DEV_RESERVATIONS_CPUS=0.25
# API_DEV_RESERVATIONS_MEMORY=256M
#
# UI_DEV_LIMITS_CPUS=1.5
# UI_DEV_LIMITS_MEMORY=1G
# UI_DEV_RESERVATIONS_CPUS=0.25
# UI_DEV_RESERVATIONS_MEMORY=256M
#
# API_LIMITS_CPUS=1.0
# API_LIMITS_MEMORY=512M
# API_RESERVATIONS_CPUS=0.25
# API_RESERVATIONS_MEMORY=128M
#
# UI_LIMITS_CPUS=0.5
# UI_LIMITS_MEMORY=128M
# UI_RESERVATIONS_CPUS=0.1
# UI_RESERVATIONS_MEMORY=32M

# ---- WUD (What's Up Docker) — enabled by default when STACK=prod ----
# Watches GHCR for new api/ui tags. Default behaviour is notify-only.
# WUD_DISCORD_WEBHOOK=          # optional; Discord incoming webhook URL
# WUD_SLACK_BOT_TOKEN=          # optional; Slack bot token (xoxb-...)
# WUD_SLACK_CHANNEL=            # optional; Slack channel name (e.g. docker-updates)
# WUD_GHCR_USERNAME=            # GitHub username for private GHCR (forks)
# WUD_GHCR_TOKEN=               # PAT with read:packages scope
# WUD_SCHEDULE=0 */6 * * *      # cron for registry polling
# WUD_TRIGGER_DOCKER_APP_AUTO=false  # default: notify only. Set true to auto pull+recreate.
# WUD_TRIGGER_DOCKER_APP_PRUNE=true
#
# API_MIGRATE_LIMITS_CPUS=0.5
# API_MIGRATE_LIMITS_MEMORY=512M
