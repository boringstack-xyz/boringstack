{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active users (24h)",
      "description": "Distinct users with a successful sign-in in the last 24 hours. From audit.audit_log.",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(cnpg_boringstack_active_users_last_1d)", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active users (7d)",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(cnpg_boringstack_active_users_last_7d)", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active users (30d)",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(cnpg_boringstack_active_users_last_30d)", "instant": true }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "none", "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Sign-ups per day (90d)",
      "description": "Accounts created per UTC day. From auth.users.",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (day) (cnpg_boringstack_signups_daily_users)", "instant": true, "format": "table" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "day", "desc": true }] },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "day": "Day", "Value": "Sign-ups" } } }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Subscriptions canceled per day (90d)",
      "description": "Paid subscriptions canceled per UTC day. Approximate: uses the last update time of the canceled row. From billing.account_plans.",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (day) (cnpg_boringstack_churn_daily_canceled)", "instant": true, "format": "table" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "day", "desc": true }] },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "day": "Day", "Value": "Canceled" } } }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Accounts by plan and status",
      "description": "Accounts currently holding a plan, excluding revoked rows. Accounts on the default Free plan have no row and are not counted. From billing.account_plans.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (plan, status) (cnpg_boringstack_account_plans_accounts)", "instant": true, "legendFormat": "{{plan}} / {{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Stripe webhook events by type",
      "description": "Stored Stripe webhook events grouped by type. From billing.stripe_webhook_events.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (type) (cnpg_boringstack_stripe_webhooks_events)", "instant": true, "legendFormat": "{{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["boringstack", "business"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "time": { "from": "now-90d", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Business metrics",
  "uid": "boringstack-business",
  "version": 1
}
