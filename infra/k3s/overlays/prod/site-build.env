# Build-time public site configuration for production images. Read by
# .github/workflows/apps-site-release.yml and apps-site-validate.yml, and passed as
# --build-arg values. Changing any value rebuilds the site image.
#
# Placeholders: rename-project.sh rewrites the boringstack.example.com host. Replace
# the mailbox with one you monitor before launch. Optional analytics stays off
# until both ANALYTICS_* values are set (see apps/site/README.md).
SITE_URL=https://boringstack.example.com
APP_URL=https://app.boringstack.example.com
CONTACT_EMAIL=hello@boringstack.example.com
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=
