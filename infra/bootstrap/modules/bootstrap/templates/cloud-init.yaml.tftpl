#cloud-config
#
# BoringStack first-boot bootstrap.
#
# Strategy: install the bare minimum (Docker, git, a couple of utilities) and
# then run a versioned bash script. Stack-specific wiring lives in
# bootstrap.sh, which is far easier to read and debug than YAML interpolation.

package_update: true
package_upgrade: false  # don't surprise the operator with a kernel bump on first boot

packages:
  - ca-certificates
  - curl
  - git
  - gnupg
  - jq

write_files:
  - path: /opt/boringstack/compose.env
    permissions: "0600"
    owner: root:root
    content: |
      ${indent(6, env_file_contents)}

  - path: /opt/boringstack/bootstrap.sh
    permissions: "0755"
    owner: root:root
    content: |
      ${indent(6, bootstrap_script)}

  - path: /etc/boringstack/config.json
    permissions: "0644"
    owner: root:root
    content: |
      ${indent(6, bootstrap_config_json)}

%{ if docker_config_json != "" ~}
  # Private-GHCR pull credentials. `docker compose pull` and WUD both
  # honour this file. 0600 because the encoded `auth` value is a bearer
  # token equivalent.
  - path: /root/.docker/config.json
    permissions: "0600"
    owner: root:root
    content: |
      ${indent(6, docker_config_json)}
%{ endif ~}

runcmd:
  # Install Docker from the official apt repository with GPG verification —
  # piping get.docker.com to sh executes an unverified remote script as
  # root at the most privileged moment of the server's life. The key's
  # fingerprint is pinned (Docker's published release key); apt then
  # signature-checks every package against it.
  - [install, -m, "0755", -d, /etc/apt/keyrings]
  - [bash, -o, pipefail, -c, "curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc"]
  - [chmod, a+r, /etc/apt/keyrings/docker.asc]
  - [bash, -o, pipefail, -c, "gpg --show-keys --with-fingerprint --with-colons /etc/apt/keyrings/docker.asc | grep -q '^fpr:::::::::9DC858229FC7DD38854AE2D88D81803C0EBFCD88:' || { echo 'Docker GPG key fingerprint mismatch' >&2; exit 1; }"]
  - [bash, -o, pipefail, -c, "echo \"deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable\" > /etc/apt/sources.list.d/docker.list"]
  - [apt-get, update]
  - [apt-get, install, -y, docker-ce, docker-ce-cli, containerd.io, docker-buildx-plugin, docker-compose-plugin]
  - [systemctl, enable, --now, docker]
  # Run the bootstrap script. Output goes to /var/log/boringstack-bootstrap.log.
  - [bash, -o, pipefail, -c, "/opt/boringstack/bootstrap.sh 2>&1 | tee /var/log/boringstack-bootstrap.log"]

final_message: |
  Cloud-init finished. BoringStack bootstrap log:
    /var/log/boringstack-bootstrap.log
  Check service status with:
    cd /opt/boringstack/infra && ./scripts/compose-up.sh ps
