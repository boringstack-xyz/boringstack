# compose/.env — rendered by OpenTofu at provision time.
# Do not edit by hand; re-render via `tofu apply`.

STACK=${stack}

# DNS — single host for same-origin path routing.
# Traefik routes /api/* + /health → api, everything else → ui.
PUBLIC_UI_HOST=${public_ui_host}
ACME_EMAIL=${acme_email}

# GHCR coordinates derived from monorepo_repo by tofu. A fork + rename flow
# needs no manual image-name override here.
IMAGE_OWNER=${image_owner}
API_IMAGE_NAME=${api_image_name}
UI_IMAGE_NAME=${ui_image_name}

# Optional first-boot superuser. Set superuser_email + superuser_password
# in terraform.tfvars to create a privileged user on first migrate. Both
# empty = no user seeded; sign up via the registration flow instead.
SUPERUSER_EMAIL=${superuser_email}
SUPERUSER_PASSWORD=${superuser_password}

# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=${postgres_password}
POSTGRES_DB=app

# Valkey
VALKEY_PASSWORD=${valkey_password}

# API secrets. API_DEV_* are read by the api-dev container (development
# overlay); the bare names without API_DEV_ are required by the prod api
# service and validated by compose/dev.sh before invoking docker compose.
API_DEV_JWT_SECRET=${jwt_secret}
JWT_SECRET=${jwt_secret}
FRONTEND_URL=https://${public_ui_host}
PUBLIC_API_URL=https://${public_ui_host}/api
ALLOWED_ORIGINS=

# Email provider
EMAIL_PROVIDER=${email_provider}
EMAIL_FROM=${email_from}
CLOUDFLARE_ACCOUNT_ID=${cloudflare_account_id}
CLOUDFLARE_EMAIL_API_TOKEN=${cloudflare_email_api_token}
RESEND_API_KEY=${resend_api_key}
SENDGRID_API_KEY=${sendgrid_api_key}

# OAuth
GOOGLE_OAUTH_CLIENT_ID=${google_oauth_client_id}
GOOGLE_OAUTH_CLIENT_SECRET=${google_oauth_client_secret}
GITHUB_OAUTH_CLIENT_ID=${github_oauth_client_id}
GITHUB_OAUTH_CLIENT_SECRET=${github_oauth_client_secret}

# Billing
STRIPE_SECRET_KEY=${stripe_secret_key}
STRIPE_WEBHOOK_SECRET=${stripe_webhook_secret}

# Error tracking
SENTRY_DSN=${sentry_dsn}
VITE_SENTRY_DSN=${vite_sentry_dsn}
