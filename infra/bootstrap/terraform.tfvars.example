# ============================================================================
# Copy this file to `terraform.tfvars` and fill in real values.
# `terraform.tfvars` is gitignored. Never commit it.
#
# Generate strong secrets with:
#   openssl rand -base64 32
# ============================================================================

# ----------------------------------------------------------------------------
# Provider credentials  (required)
# ----------------------------------------------------------------------------

hetzner_api_token    = ""  # Hetzner Cloud → Security → API Tokens → Read & Write
cloudflare_api_token = ""  # Cloudflare → My Profile → API Tokens → custom token
                            # with: Zone:DNS:Edit, Zone:Zone Settings:Edit,
                            #       Zone:Rulesets:Edit on the target zone
cloudflare_zone_id   = ""  # Zone overview page, right sidebar

# ----------------------------------------------------------------------------
# Domain + access  (required)
# ----------------------------------------------------------------------------

domain          = "example.com"
ssh_public_key  = ""  # paste full key including "ssh-ed25519 ..."
ssh_allowed_ips = []  # REQUIRED: your admin CIDRs, e.g. ["203.0.113.7/32"].
                      # ["0.0.0.0/0", "::/0"] opens SSH to the world - only
                      # if you truly mean it. Empty fails validation.

# ----------------------------------------------------------------------------
# Edge security + performance  (optional; all on by default, all free-tier)
#
# Handled at the Cloudflare edge, before traffic reaches Traefik / api / ui:
#   - bot-block WAF rule: scanner paths (/.env, /.git/, /wp-admin, …), any
#     hidden dotfile, and empty/known-scanner user agents. Review the path
#     list against your routes; never include /.well-known/acme-challenge.
#   - auth rate limit: Managed Challenge on /api/auth/* (Cloudflare's one free
#     rate-limiting rule). If your plan rejects it, set enable_auth_rate_limit=false.
#   - edge cache: cache Vite's hashed /assets/* for a year, bypass /api/*.
#   - DNSSEC: auto at Cloudflare Registrar; else add the dnssec_ds_record DS
#     output at your registrar once.
# ----------------------------------------------------------------------------

# enable_bot_blocking          = true
# bot_block_paths              = ["/.env", "/.git/", "/.aws/", "/actuator/", "/wp-admin/", "/wp-login", "/xmlrpc", "/phpmyadmin/", "/laravel/", "/backend/", "/config.php", "/server-status"]
# block_suspicious_user_agents = true
# enable_auth_rate_limit       = true
# auth_rate_limit_requests     = 20
# auth_rate_limit_period       = 60   # 10 | 60 | 120 | 300 | 600 | 3600
# enable_edge_cache            = true
# enable_dnssec                = true

# ----------------------------------------------------------------------------
# VPS sizing (Hetzner-native names)
# ----------------------------------------------------------------------------

# vps_type     = "cx32"          # 4 vCPU / 8 GB (default sizing target)
# vps_location = "fsn1"          # fsn1 | nbg1 | hel1 | ash | hil
# vps_image    = "ubuntu-24.04"
# vps_name     = "boringstack"

# Guard the VPS against destroy/replace (default true). Set false only for a
# deliberate rebuild — the box holds all persistent Docker volumes.
# prevent_server_destroy = true

# ----------------------------------------------------------------------------
# Stack secrets  (required)
# ----------------------------------------------------------------------------

jwt_secret        = ""  # 32+ chars; openssl rand -base64 32
postgres_password = ""  # openssl rand -base64 32
valkey_password   = ""  # openssl rand -base64 32
acme_email        = "ops@example.com"  # real address; Let's Encrypt rejects example.com

# ----------------------------------------------------------------------------
# Repo to clone on first boot (override for forks)
# ----------------------------------------------------------------------------

# monorepo_repo = "https://github.com/boringstack-xyz/boringstack"

# ----------------------------------------------------------------------------
# Private GHCR auth  (optional; required if your fork pushes images to a
# private GitHub Container Registry — leave empty for public images.)
#
# GitHub PAT (classic) with `read:packages` scope. Set both or neither;
# the bootstrap renders a `docker login ghcr.io` only when both are set.
# ----------------------------------------------------------------------------

# ghcr_username = ""
# ghcr_token    = ""

# ----------------------------------------------------------------------------
# First-boot superuser seed  (optional)
#
# When both are set, the api-migrate job creates this user as an admin on
# first boot. Skip both to register through the UI yourself after apply.
# Rotate the password from the UI's password-reset flow once you're in.
# ----------------------------------------------------------------------------

# superuser_email    = ""
# superuser_password = ""  # min length enforced by the API env validator

# ----------------------------------------------------------------------------
# Email provider  (optional; leave empty to disable)
#
# Cloudflare Email Service is cheapest at scale (bundled into Workers Paid).
# See https://boringstack.xyz/runbooks/cloudflare-email-setup/.
# ----------------------------------------------------------------------------

# email_provider             = ""  # "" disables email; or cloudflare | resend | sendgrid
# email_from                 = "noreply@example.com"
# cloudflare_account_id      = ""
# cloudflare_email_api_token = ""
# resend_api_key             = ""
# sendgrid_api_key           = ""

# ----------------------------------------------------------------------------
# OAuth providers  (optional)
# ----------------------------------------------------------------------------

# google_oauth_client_id     = ""
# google_oauth_client_secret = ""
# github_oauth_client_id     = ""
# github_oauth_client_secret = ""
# linkedin_oauth_client_id     = ""
# linkedin_oauth_client_secret = ""

# ----------------------------------------------------------------------------
# Billing  (optional)
# ----------------------------------------------------------------------------

# stripe_secret_key     = ""
# stripe_webhook_secret = ""

# ----------------------------------------------------------------------------
# Error tracking  (optional)
# ----------------------------------------------------------------------------

# sentry_dsn      = ""
# vite_sentry_dsn = ""

# ----------------------------------------------------------------------------
# Backups  (optional; requires rclone configured on the host post-apply)
# ----------------------------------------------------------------------------

# backups_enabled       = false
# rclone_remote_name    = ""
# rclone_remote_path    = ""
# backup_retention_days = 30
